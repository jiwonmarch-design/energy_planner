# Copy this file to .env and paste the local development key after the equals sign.
# Never commit a real API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REASONING_EFFORT=
# Includes reasoning and visible JSON; reserve more room for high effort.
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_TIMEOUT_SECONDS=20
